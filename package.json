{
  "name": "twinlink",
  "version": "0.0.1",
  "description": "A lightweight toolkit for creating direct 1-on-1 browser-to-browser connections using WebRTC Data Channels.",
  "keywords": [
    "webrtc",
    "p2p",
    "datachannel",
    "browser-to-browser",
    "1-on-1"
  ],
  "homepage": "https://github.com/ronny1020/twinlink#readme",
  "bugs": {
    "url": "https://github.com/ronny1020/twinlink/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ronny1020/twinlink.git"
  },
  "license": "Apache-2.0",
  "author": "",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./dist/index.mjs": "./dist/index.mjs"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.mjs",
  "jsdelivr": "./dist/index.mjs",
  "files": [
    "dist"
  ],
  "workspaces": [
    "demo"
  ],
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts --outdir ./dist --minify --sourcemap=inline && mv dist/index.js dist/index.mjs && bun build src/index.ts --outdir ./dist --minify --sourcemap=inline --format=cjs && mv dist/index.js dist/index.cjs && tsc -p tsconfig.build.json && cp dist/index.d.ts dist/index.mjs.d.ts && cp dist/index.d.ts dist/index.cjs.d.ts && rm -f dist/*.test.d.ts",
    "demo": "bun --filter demo start",
    "demo:build": "bun --filter demo build",
    "dev": "bun build src/index.ts --outdir ./dist --watch",
    "format": "prettier --write .",
    "lint": "eslint .",
    "prepare": "husky || true",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "release:check": " bun i && bun run test && bun run lint && bun run typecheck && bun run build",
    "prepublishOnly": "bun run release:check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "eslint": "^10.4.1",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.3",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.60.1"
  }
}
